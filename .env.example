# ─────────────────────────────────────────────
# Cold Drinks Distribution App — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the .env file to git!

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# ── Database (local SQLite, offline) ────────────────────────────────────────
# Optional. Leave unset and the app automatically uses a local SQLite file at
# instance/coldrink.db (created on first run) — no external database needed.
# Only set this if you want the file somewhere else, e.g.:
# DATABASE_URL=sqlite:///C:/path/to/some/other/file.db
# DATABASE_URL=

# ── Single shared login (father / office use only — no per-staff accounts) ─
ADMIN_USERNAME=admin
# Generate a hash for your chosen password with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password_here'))"
ADMIN_PASSWORD_HASH=change_me_generate_with_werkzeug
